# Private balancer for the engine replicas. Active health checks take a draining (503 /readyz) replica out of rotation.
{
	auto_https off
	admin off
}
:8765 {
	request_body {
		max_size 100MB
	}
	reverse_proxy engine-a:8765 engine-b:8765 {
		lb_policy header X-OpenBooks-Job {
			fallback least_conn
		}
		lb_try_duration 3s
		health_uri /readyz
		health_interval 3s
		health_timeout 2s
		health_status 2xx
		fail_duration 10s
		flush_interval -1
	}
}
