# Where the Open Books engine service listens. Keep it on loopback; only this server talks to it.
OPENBOOKS_ENGINE_URL=http://127.0.0.1:8765

# Pooled Neon connection for the shared API rate limiter and subscriptions.
# Apply migrations/001_rate_buckets.sql using a direct connection before deployment.
DATABASE_URL=

# Optional. Enables plain-language questions about released documents.
# Without both values, file runs still work and the composer explains that Q&A is off.
# Any OpenAI-compatible endpoint works; the default base URL is OpenRouter (set OPENBOOKS_LLM_BASE_URL to change it).
OPENBOOKS_LLM_API_KEY=
# An open-weights model that supports tool calls, e.g. google/gemma-4-31b-it:free or qwen/qwen3-next-80b-a3b-instruct
OPENBOOKS_LLM_MODEL=
