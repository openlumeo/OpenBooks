{
  "name": "openbooks-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:engine": "node scripts/dev-engine.mjs",
    "dev:all": "concurrently -k -n engine,web -c green,magenta \"pnpm dev:engine\" \"pnpm dev\"",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "geist": "1.9.2",
    "idb": "^8.0.4",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "openai": "^7.61.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
