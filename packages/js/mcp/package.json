{
  "name": "@lumeo_hq/openbooks-mcp",
  "version": "0.2.3",
  "description": "MCP server that lets AI agents verify bank statements, settlements and tax documents with Open Books and get proven JSON or a typed refusal. Run with npx -y @lumeo_hq/openbooks-mcp.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "bank-statement",
    "financial-documents",
    "ocr",
    "reconciliation",
    "openbooks",
    "lumeo"
  ],
  "homepage": "https://openbooks.lumeo.co.in/docs/mcp",
  "bugs": {
    "url": "https://github.com/Sagexd08/openbooks-js/issues"
  },
  "author": "Lumeo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagexd08/openbooks-js.git",
    "directory": "mcp"
  },
  "mcpName": "io.github.Sagexd08/openbooks-mcp",
  "type": "module",
  "bin": {
    "openbooks-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lumeo_hq/openbooks": "workspace:*",
    "@lumeo_hq/openbooks-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "scripts": {
    "gen:workspace": "node scripts/gen-workspace.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
