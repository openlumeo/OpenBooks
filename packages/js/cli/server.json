{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Sagexd08/openbooks-mcp",
  "description": "Verify bank statements, settlements and tax documents: proven JSON or a typed refusal.",
  "repository": {
    "url": "https://github.com/Sagexd08/OpenBooks",
    "source": "github",
    "subfolder": "packages/js/cli"
  },
  "version": "0.2.5",
  "websiteUrl": "https://openbooks.openlumeo.com/docs/mcp",
  "icons": [
    {
      "src": "https://openbooks.openlumeo.com/brand/mark-white.png",
      "mimeType": "image/png",
      "sizes": ["370x392"],
      "theme": "dark"
    },
    {
      "src": "https://openbooks.openlumeo.com/brand/mark-black.png",
      "mimeType": "image/png",
      "sizes": ["185x196"],
      "theme": "light"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@lumeo_hq/openbooks",
      "version": "0.2.5",
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ],
      "transport": { "type": "stdio" }
    }
  ]
}
